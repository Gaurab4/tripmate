# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — local (docker compose)
DB_NAME=tripmate
DB_USER=tripuser
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Database — Supabase (production on Render)
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require

# API keys
# GEMINI_API_KEY=...
# GOOGLE_PLACES_API_KEY=...

# Production (Render)
# DEBUG=False
# ALLOWED_HOSTS=tripmate-api.onrender.com
